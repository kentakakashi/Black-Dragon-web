# Server-side Netlify environment variables (never commit real values)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://YOUR-SITE.netlify.app/.netlify/functions/discord-oauth-callback
# DISCORD_GUILD_ID=
# DISCORD_BOT_TOKEN=
# SESSION_SECRET=use-a-random-secret-at-least-32-characters
# SITE_URL=https://YOUR-SITE.netlify.app
# FIREBASE_SERVICE_ACCOUNT_JSON=
# APPLICATION_REVIEW_ROLE_IDS=comma-separated Discord role IDs
# EVENT_MANAGE_ROLE_IDS=comma-separated Discord role IDs (falls back to application review roles)
# CONTENT_MANAGE_ROLE_IDS=comma-separated Discord role IDs (falls back to application review roles)
# ANNOUNCEMENT_MANAGE_ROLE_IDS=comma-separated Discord role IDs (falls back to application review roles)
# STAFF_ROLE_IDS=comma-separated Discord role IDs shown on the public Staff page
