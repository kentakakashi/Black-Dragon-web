# Public community invite link. Safe to expose in the browser bundle.
VITE_DISCORD_INVITE_URL=https://discord.gg/7C2uT3YX6E

# Add these as Netlify environment variables (server-side only).
# Never prefix secrets with VITE_ and never commit real values.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://YOUR-SITE.netlify.app/.netlify/functions/discord-oauth-callback
# DISCORD_GUILD_ID=
# DISCORD_BOT_TOKEN=
# SESSION_SECRET=use-a-random-secret-at-least-32-characters
# SITE_URL=https://YOUR-SITE.netlify.app
# FIREBASE_SERVICE_ACCOUNT_JSON=
